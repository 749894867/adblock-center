DOMAIN-SUFFIX,cm.bilibili.com,REJECT
URL-REGEX,^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/ad,REJECT

[MITM]
hostname = %APPEND% app.bilibili.com, app.biliapi.net, grpc.biliapi.net, api.bilibili.com

[Script]
bili_splash = type=http-request,pattern=^https:\/\/(app\.bilibili\.com|app\.biliapi\.net)(?::443)?\/x\/v2\/splash\/list(?:\?[^#]*)?$,timeout=10,script-path=https://749894867.github.io/adblock-center/scripts/bilibili-splash.js
bili_json = type=http-response,pattern=^https:\/\/(app\.bilibili\.com|app\.biliapi\.net)\/x\/(v2\/(splash\/(list|show|event\/list2|brand\/list)|feed\/index\?)|resource\/show\/tab\/v2),requires-body=1,timeout=25,script-path=https://749894867.github.io/adblock-center/scripts/bilibili-json.js
bili_proto = type=http-response,pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.net)\/bilibili\.app\.(viewunite\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll)$,requires-body=1,binary-body-mode=1,timeout=30,script-path=https://749894867.github.io/adblock-center/scripts/bilibili-proto.js
